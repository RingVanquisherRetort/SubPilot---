NODE_ENV=development
PORT=3000
HOST=0.0.0.0
PUBLIC_API_URL=http://localhost:3000

DATABASE_URL=postgresql://subpilot:subpilot_dev_password@localhost:5432/subpilot?schema=public
REDIS_URL=redis://localhost:6379

# Telegram central control bot token from @BotFather.
# Configure the same token for both the control-bot and API services (owner notification delivery).
CONTROL_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to manage the global SubPilot plan catalogue.
# Empty means no platform-admin commands are available to anyone.
PLATFORM_ADMIN_TELEGRAM_IDS=

# Generate with: openssl rand -base64 32
# Encrypts customer bot tokens and payment-provider credentials at rest.
SECRETS_ENCRYPTION_KEY=
