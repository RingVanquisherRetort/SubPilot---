NODE_ENV=development

# Opt-in for isolated development channels only. Production sends joined-member removals to review.
TEST_TELEGRAM_AUTOMATIC_MEMBER_BAN=false
PORT=3000
HOST=0.0.0.0
PUBLIC_API_URL=http://localhost:3000

DATABASE_URL=postgresql://subpilot:subpilot_dev_password@localhost:5432/subpilot?schema=public
REDIS_URL=redis://localhost:6379

# Telegram central control bot token from @BotFather.
# Configure the same token for both the control-bot and API services (owner notification delivery).
CONTROL_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to manage the global SubPilot plan catalogue.
# Empty means no platform-admin commands are available to anyone.
PLATFORM_ADMIN_TELEGRAM_IDS=

# Generate with: openssl rand -base64 32
# Encrypts customer bot tokens and payment-provider credentials at rest.
SECRETS_ENCRYPTION_KEY=

# HTTPS return URL for an authenticated, independent SubPilot web checkout.
# Do not use it to route Telegram-bot/Mini-App digital-service purchases around Telegram Stars.
PLATFORM_BILLING_RETURN_URL=

# Telegram Login Widget identity used by the independent billing website.
TELEGRAM_LOGIN_BOT_USERNAME=

# Web billing is fail-closed. Only enable after the website journey, product relation
# and provider merchant approval have been reviewed; do not set TPA_RELATED=false
# merely to bypass Telegram Stars requirements for bot/Mini-App digital services.
PLATFORM_BILLING_WEB_ENABLED=false
PLATFORM_BILLING_WEB_COMPLIANCE_REVIEWED=false
PLATFORM_BILLING_TELEGRAM_TPA_RELATED=true
PLATFORM_BILLING_WEB_ORIGIN=
PLATFORM_BILLING_WEB_SESSION_SECRET=
# Exact active SubPilot-owned YooKassa connection ID; never accepted from browser input.
PLATFORM_BILLING_PROVIDER_CONNECTION_ID=
