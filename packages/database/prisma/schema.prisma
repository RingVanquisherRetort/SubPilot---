generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  PERSONAL
  AGENCY
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum BotStatus {
  PENDING
  ACTIVE
  ERROR
  DISABLED
}

enum TelegramChatType {
  CHANNEL
  GROUP
  SUPERGROUP
}

enum CreatorPlanStatus {
  ACTIVE
  ARCHIVED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  PAST_DUE
}

enum PaymentProvider {
  TELEGRAM_STARS
  YOOKASSA
  YOOMONEY
  PRODAMUS
  ROBOKASSA
  CLOUDPAYMENTS
  CRYPTO_PAY
  MANUAL
}

enum ProviderConnectionStatus {
  PENDING
  ACTIVE
  ERROR
  DISABLED
}

enum ProviderEnvironment {
  TEST
  LIVE
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  REFUNDING
  FAILED
  CANCELLED
  REFUNDED
}

enum WorkspaceBillingStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum CreatorMerchantType {
  INDIVIDUAL
  SELF_EMPLOYED
  INDIVIDUAL_ENTREPRENEUR
  LEGAL_ENTITY
}

enum PlatformCommissionEntryType {
  SALE_FEE
  REFUND_ADJUSTMENT
  MANUAL_ADJUSTMENT
  PAYMENT
}

enum PlatformCommissionStatus {
  ACCRUED
  INVOICED
  PAID
  VOID
}

model User {
  id                String            @id @default(cuid())
  telegramId        BigInt            @unique
  username          String?
  firstName         String?
  lastName          String?
  languageCode      String?
  activeWorkspaceId String?
  memberships        WorkspaceMember[]
  createdInvites     WorkspaceInvite[] @relation("WorkspaceInviteCreator")
  createdWorkspaces  Workspace[]       @relation("WorkspaceCreator")
  createdProjects    Project[]         @relation("ProjectCreator")
  ownerNotifications OwnerNotification[]
  auditEvents        AuditLog[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  type        WorkspaceType     @default(PERSONAL)
  createdById String
  createdBy   User              @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     WorkspaceMember[]
  invites     WorkspaceInvite[]
  projects    Project[]
  billing     WorkspaceBilling?
  auditLogs   AuditLog[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MANAGER)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId, role])
}

model WorkspaceInvite {
  id              String        @id @default(cuid())
  workspaceId     String
  invitedByUserId String
  tokenHash       String        @unique
  role            WorkspaceRole @default(MANAGER)
  expiresAt       DateTime
  usedAt          DateTime?
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy       User           @relation("WorkspaceInviteCreator", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@index([workspaceId, expiresAt, usedAt])
  @@index([invitedByUserId, createdAt])
}

model Project {
  id                 String                      @id @default(cuid())
  workspaceId        String
  name               String
  slug               String
  countryCode        String                      @default("RU")
  merchantType       CreatorMerchantType         @default(INDIVIDUAL)
  status             ProjectStatus               @default(ACTIVE)
  defaultCurrency    String                      @default("RUB")
  workspace          Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creatorUserId      String?
  creatorUser        User?                         @relation("ProjectCreator", fields: [creatorUserId], references: [id], onDelete: SetNull)
  ownerNotifications OwnerNotification[]
  bots               ProjectBot[]
  chats              ConnectedChat[]
  plans              CreatorPlan[]
  customers          ProjectCustomer[]
  subscriptions      Subscription[]
  paymentConnections PaymentProviderConnection[]
  payments           Payment[]
  commissionEntries  PlatformCommissionEntry[]
  auditLogs          AuditLog[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([creatorUserId])
}

model ProjectBot {
  id                String    @id @default(cuid())
  projectId         String
  telegramBotId     BigInt    @unique
  username          String?
  displayName       String?
  tokenEncrypted    String
  webhookSecretHash String?
  status            BotStatus @default(PENDING)
  isPrimary         Boolean   @default(true)
  lastVerifiedAt    DateTime?
  lastUpdateId      BigInt?
  updateSequenceEpoch Int      @default(0)
  lastUpdateId      Int?
  lastUpdateAt      DateTime?
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  webhookUpdates    TelegramWebhookUpdate[]
  chatMemberCursors TelegramChatMemberCursor[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([projectId, status])
}


model TelegramWebhookUpdate {
  id           String     @id @default(cuid())
  projectBotId String
  updateId     Int
  sequenceEpoch Int
  updateType   String
  attempts     Int        @default(1)
  lastError    String?
  receivedAt   DateTime   @default(now())
  processedAt  DateTime?
  projectBot   ProjectBot @relation(fields: [projectBotId], references: [id], onDelete: Cascade)

  @@unique([projectBotId, updateId])
  @@index([projectBotId, processedAt, receivedAt])
}

model TelegramChatMemberCursor {
  id             String     @id @default(cuid())
  projectBotId   String
  telegramChatId BigInt
  telegramUserId BigInt
  lastUpdateId   Int
  sequenceEpoch  Int
  projectBot     ProjectBot @relation(fields: [projectBotId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([projectBotId, telegramChatId, telegramUserId])
  @@index([projectBotId, sequenceEpoch, lastUpdateId])
}

model ConnectedChat {
  id             String            @id @default(cuid())
  projectId      String
  telegramChatId BigInt
  type           TelegramChatType
  title          String?
  username       String?
  isActive       Boolean           @default(true)
  lastBotStatusUpdateId Int?
  lastBotStatusSequenceEpoch Int?
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planLinks      CreatorPlanChat[]
  accessGrants   SubscriptionAccessGrant[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([projectId, telegramChatId])
  @@index([projectId, isActive])
}

model CreatorPlan {
  id              String            @id @default(cuid())
  projectId       String
  title           String
  description     String?
  price           Decimal           @db.Decimal(12, 2)
  currency        String            @default("RUB")
  durationDays    Int?
  trialDays       Int               @default(0)
  isRecurring     Boolean           @default(false)
  status          CreatorPlanStatus @default(ACTIVE)
  sortOrder       Int               @default(0)
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chats           CreatorPlanChat[]
  subscriptions   Subscription[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([projectId, status, sortOrder])
}

model CreatorPlanChat {
  creatorPlanId   String
  connectedChatId String
  creatorPlan     CreatorPlan  @relation(fields: [creatorPlanId], references: [id], onDelete: Cascade)
  connectedChat  ConnectedChat @relation(fields: [connectedChatId], references: [id], onDelete: Cascade)

  @@id([creatorPlanId, connectedChatId])
}

model ProjectCustomer {
  id             String         @id @default(cuid())
  projectId      String
  telegramUserId BigInt
  username       String?
  firstName      String?
  lastName       String?
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  payments       Payment[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([projectId, telegramUserId])
  @@index([projectId, createdAt])
}

model Subscription {
  id          String             @id @default(cuid())
  projectId   String
  customerId  String
  planId      String
  status      SubscriptionStatus @default(PENDING)
  startsAt    DateTime?
  endsAt      DateTime?
  cancelledAt DateTime?
  reminder3dAt DateTime?
  reminder1dAt DateTime?
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customer    ProjectCustomer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan        CreatorPlan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments    Payment[]
  accessGrants SubscriptionAccessGrant[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([projectId, status, endsAt])
  @@index([customerId, status])
}

model SubscriptionAccessGrant {
  id                String        @id @default(cuid())
  subscriptionId    String
  connectedChatId   String
  inviteLink        String
  expiresAt         DateTime
  joinedAt          DateTime?
  revokedAt         DateTime?
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  connectedChat     ConnectedChat @relation(fields: [connectedChatId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([subscriptionId, connectedChatId])
  @@index([connectedChatId, joinedAt, expiresAt])
}

model PaymentProviderConnection {
  id                   String                   @id @default(cuid())
  projectId            String
  provider             PaymentProvider
  label                String
  environment          ProviderEnvironment      @default(LIVE)
  credentialsEncrypted String
  publicConfig         Json?
  status               ProviderConnectionStatus @default(PENDING)
  project              Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payments             Payment[]
  webhookEvents        PaymentWebhookEvent[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@unique([projectId, provider, label])
  @@index([projectId, provider, status])
}

model Payment {
  id                String          @id @default(cuid())
  projectId         String
  customerId        String
  subscriptionId    String?
  connectionId      String?
  provider          PaymentProvider
  providerPaymentId String?
  idempotencyKey    String?         @unique
  amount            Decimal         @db.Decimal(12, 2)
  currency          String
  status            PaymentStatus   @default(CREATED)
  metadata          Json?
  paidAt            DateTime?
  refundedAt        DateTime?
  refundAttemptedAt DateTime?
  refundAttempts    Int             @default(0)
  refundLastError   String?
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customer          ProjectCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscription      Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  connection        PaymentProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  commissionEntries PlatformCommissionEntry[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([projectId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([connectionId, providerPaymentId])
}

model PaymentWebhookEvent {
  id              String                    @id @default(cuid())
  connectionId    String?
  dedupeKey       String?                   @unique
  providerEventId String
  eventType       String
  payload         Json
  receivedAt      DateTime                  @default(now())
  processedAt     DateTime?
  connection      PaymentProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, providerEventId])
  @@index([connectionId, receivedAt])
}

model PlatformPlan {
  id                String             @id @default(cuid())
  code              String             @unique
  title             String
  description       String?
  price             Decimal            @db.Decimal(12, 2)
  currency          String             @default("RUB")
  billingPeriodDays Int                @default(30)
  features          Json?
  isActive          Boolean            @default(true)
  workspaceBillings WorkspaceBilling[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model WorkspaceBilling {
  id                 String                 @id @default(cuid())
  workspaceId        String                 @unique
  platformPlanId     String
  status             WorkspaceBillingStatus @default(TRIALING)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  workspace          Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platformPlan       PlatformPlan           @relation(fields: [platformPlanId], references: [id], onDelete: Restrict)
  payments           PlatformPayment[]
  commissionEntries  PlatformCommissionEntry[]
  introductoryOfferCode String?
  introductoryOfferAcceptedAt DateTime?
  introductoryTrialStartedAt DateTime?
  introductoryTrialEndsAt DateTime?
  introductoryCommissionBasisPoints Int?
  introductoryTermsVersion String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model PlatformPayment {
  id                 String           @id @default(cuid())
  workspaceBillingId String
  provider           PaymentProvider
  providerPaymentId  String?
  idempotencyKey     String?          @unique
  amount             Decimal          @db.Decimal(12, 2)
  currency           String
  status             PaymentStatus    @default(CREATED)
  paidAt             DateTime?
  metadata           Json?
  workspaceBilling   WorkspaceBilling @relation(fields: [workspaceBillingId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([workspaceBillingId, status, createdAt])
}

model PlatformCommissionEntry {
  id                 String                     @id @default(cuid())
  workspaceBillingId String
  projectId          String
  creatorPaymentId   String?
  idempotencyKey     String                     @unique
  entryType          PlatformCommissionEntryType
  status             PlatformCommissionStatus  @default(ACCRUED)
  baseAmount         Decimal                    @db.Decimal(12, 2)
  baseCurrency       String
  rateBasisPoints    Int?
  feeAmount          Decimal                    @db.Decimal(12, 2)
  feeCurrency        String
  invoiceReference   String?
  paidAt             DateTime?
  metadata           Json?
  workspaceBilling   WorkspaceBilling           @relation(fields: [workspaceBillingId], references: [id], onDelete: Cascade)
  project            Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  creatorPayment     Payment?                   @relation(fields: [creatorPaymentId], references: [id], onDelete: SetNull)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([workspaceBillingId, status, createdAt])
  @@index([projectId, createdAt])
  @@index([creatorPaymentId, entryType])
}

model OwnerNotification {
  id              String    @id @default(cuid())
  projectId       String
  recipientUserId String
  eventType       String
  dedupeKey       String    @unique
  messageText     String
  sentAt          DateTime?
  attempts        Int       @default(0)
  nextAttemptAt   DateTime  @default(now())
  lastError       String?
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recipient       User     @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sentAt, nextAttemptAt])
  @@index([recipientUserId, createdAt])
}

model WorkerLease {
  key         String   @id
  leaseId     String
  lockedUntil DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id           String     @id @default(cuid())
  workspaceId  String?
  projectId    String?
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor        User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
}
